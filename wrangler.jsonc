{
  "name": "table-and-taste",
  "main": "worker.js",
  "compatibility_date": "2026-11-24",
  "assets": {"directory":"./public","binding":"ASSETS","run_worker_first":true},
  "vars": {"MONTHLY_SEARCH_LIMIT":"900"},
  "d1_databases": [{"binding":"DB","database_name":"table-and-taste","database_id":"REPLACE_WITH_D1_DATABASE_ID","migrations_dir":"migrations"}]
}
